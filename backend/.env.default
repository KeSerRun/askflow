# ============================================================
# RAG Simple 默认配置基线（程序读取的默认值）
#
# 命名规则：`分组>_<名称>`，例如 LLM_MODEL / STORAGE_DB_URL / LOG_PATH。
# 加载顺序（后者覆盖前者）：
#     系统环境变量  >  .env（部署覆盖）  >  .env.default（本文件）
# 运行期动态配置：后台「系统设置」保存写回 .env（覆盖本文件默认值，重启后仍生效）。
#
# 约定：
#   * 本文件是"默认值基线"，同时可作配置参考/示例——请勿直接改它部署，
#     把要改的项写进同目录 .env（或复制本文件为 .env 再改）。
#   * 值为 none 表示"留空 / 未设置"（等同缺失）。
#   * 注释请放在配置行的"上一行"，不要写行末（会被当成值的一部分）。
# ============================================================


# ------------------- LLM_* 对话模型（OpenAI 兼容接口） -------------------
# 对话模型 API Key。【必填】
LLM_API_KEY=none
# 对话模型 API 地址（OpenAI 兼容端点）
LLM_BASE_URL=https://api.openai.com/v1
# 对话模型名称（如 gpt-4o-mini / deepseek-v4-flash）
LLM_MODEL=gpt-4o-mini
# 推理力度：low / medium / high；none 表示不指定
LLM_REASONING_EFFORT=none
# 采样温度：越低越稳定（工具调用建议 0.2~0.4）
LLM_TEMPERATURE=0.3
# LLM 请求超时（秒）
LLM_TIMEOUT=60
# LLM 请求最大重试次数
LLM_MAX_RETRIES=3
# 健康检查地址（留空则按 LLM_BASE_URL 推导：+/models）
LLM_HEALTH_URL=none


# ------------------- EMBED_* 嵌入模型（本地 embedding 服务 / 云端 API 二选一） -------------------
# 本地模式默认（docker compose 启动 embedding 服务后）：Chinese-CLIP, 512 维
# 切云 API 时：EMBED_BASE_URL 与 EMBED_API_KEY 改为您的服务地址与 Key
EMBED_API_KEY=sk-local
EMBED_BASE_URL=http://127.0.0.1:7997/v1
# 嵌入模型名称（本地 clip-api 服务固定 OFA-Sys/chinese-clip-vit-base-patch16）
EMBED_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
# 嵌入向量维度，需与模型一致（Chinese-CLIP base 为 512）
EMBED_DIM=512
# 健康检查地址（留空则按 EMBED_BASE_URL 推导：去掉末尾 /v1 后 + /health）
EMBED_HEALTH_URL=none


# ------------------- MINERU_* PDF 解析服务（本地 MinerU 4.x，单文件 V1） -------------------
# 本地服务默认无鉴权；服务端启用 --api-key 时填同一个 Key
MINERU_API_KEY=sk-local
# 本地 MinerU API 地址（docker compose 的 mineru-api）
MINERU_BASE_URL=http://127.0.0.1:8000
# 解析档位：flash / basic / standard（CPU 建议 basic）
MINERU_TIER=basic
# 最大并发数（上传解析并发上限）
MINERU_MAX_CONCURRENCY=3
# 健康检查地址（留空则按 MINERU_BASE_URL 推导：+/v1/health）
MINERU_HEALTH_URL=none
MILVUS_HEALTH_URL=none
MINIO_HEALTH_URL=none


# ------------------- STORAGE_* 存储 / 路径 -------------------
# 数据根目录（相对 backend/；向量库 / 日志 / 上传都在其下）
STORAGE_DATA_DIR=data
# 存储后端：sqlite（本地文件库）/ mysql（Docker 服务）
STORAGE_BACKEND=sqlite
# 数据库连接串（sqlite 默认 sqlite:///data/rag.db；MySQL 用 mysql+pymysql://...）
STORAGE_DB_URL=sqlite:///data/rag.db


# ------------------- RETRIEVAL_* 知识库检索 -------------------
# 检索返回的相似结果数上限
RETRIEVAL_TOP_K=10
# 重排前的候选数量
RETRIEVAL_CANDIDATE_K=5
# 文本块最小字符数（低于该值会被过滤）
RETRIEVAL_MIN_CHUNK=5
# 文本块停用词（逗号分隔，命中即过滤；none 表示不设置）
RETRIEVAL_STOP_WORDS=联系人, 电话, 手机, 邮箱, 传真, 邮件, 网址, 地址, 市, 区, 公司, @, com, 硕士, 博士, 大学


# ------------------- VECTOR_* 向量后端 -------------------
# 向量后端：milvus（唯一向量后端）
# Milvus 连接地址
VECTOR_MILVUS_URI=http://127.0.0.1:19530
# Milvus 鉴权 token（关闭鉴权时留空）
VECTOR_MILVUS_TOKEN=none
# Milvus 集合名
VECTOR_MILVUS_COLLECTION=rag_chunks


# ------------------- OBJECT_* 对象存储（上传文档 / 解析产物） -------------------
# 文件后端：minio（唯一文件后端）
# MinIO 地址（host:port）
OBJECT_MINIO_ENDPOINT=127.0.0.1:9000
# MinIO Access Key（与 docker-compose 的 MINIO_ROOT_USER 一致）
OBJECT_MINIO_ACCESS_KEY=minioadmin
# MinIO Secret Key（与 docker-compose 的 MINIO_ROOT_PASSWORD 一致）
OBJECT_MINIO_SECRET_KEY=minioadmin
# MinIO 存储桶名
OBJECT_MINIO_BUCKET=rag-files
# MinIO 是否使用 HTTPS（true / false）
OBJECT_MINIO_SECURE=false


# ------------------- CACHE_* / REDIS_* 缓存 / 任务进度 / 会话状态 -------------------
# 缓存后端：inprocess（进程内）/ redis（Redis 服务）
CACHE_BACKEND=inprocess
# Redis 连接地址（cache_backend=redis 时使用）
REDIS_URL=redis://127.0.0.1:6379/0


# ------------------- AGENT_* Agent 引擎 -------------------
# 单次问答的工具调用最大迭代次数（达上限可回复"继续"恢复）
AGENT_MAX_TOOL_ITER=15
# 单次 LLM 输出的最大字符数
AGENT_MAX_OUTPUT_CHARS=8192
# 是否启用 Agent 图运行检查点（断点续跑；true/false）
AGENT_CHECKPOINT_ENABLED=false


# ------------------- CONTEXT_* 上下文治理 -------------------
# 历史对话最大保留条数
CONTEXT_HISTORY_MAX=500
# 上下文窗口总字符预算（输入 + 输出上限）
CONTEXT_WINDOW_CHARS=32768
# 输入占用上下文窗口的比例（其余留给输出）
CONTEXT_INPUT_RATIO=0.8
# 历史压缩比例
CONTEXT_COMPRESSION_RATIO=0.3
# 工具结果分页读取的每页字符数
CONTEXT_TOOL_PAGE_CHARS=5000


# ------------------- SEARCH_* 联网搜索（固定使用 SearXNG 元搜索引擎） -------------------
# SearXNG 服务地址（docker compose 起 searxng 服务，默认端口 8888）
SEARCH_SEARXNG_URL=http://127.0.0.1:8888
# 搜索请求超时（秒）
SEARCH_TIMEOUT=15


# ------------------- LOG_* 日志 -------------------
# 运行环境：development / production（生产环境日志只保留 ERROR 及以上）
APP_ENV=development
# 日志输出目录
LOG_PATH=data/logs
# 应用日志级别：DEBUG / INFO / WARNING / ERROR
LOG_APP_LEVEL=INFO
# HTTP 请求日志级别
LOG_HTTP_LEVEL=INFO
# 控制台日志级别
LOG_CONSOLE_LEVEL=DEBUG
# 单个日志文件最大大小（MB），超出后轮转
LOG_MAX_MB=10
# 轮转后保留的备份文件数
LOG_BACKUP_COUNT=3

# 并发调优（app.py 读取；>1 进程时内存态按进程隔离）
APP_THREAD_POOL=200
APP_WORKERS=1


# ------------------- AUTH_* 认证 / 超级用户 -------------------
# JWT 签名密钥；none 则由程序启动时自动生成并写入 .env（保持重启稳定）
AUTH_JWT_SECRET=none
# 超级管理员用户名（逗号分隔，与密码一一对应）
AUTH_SUPERUSER_USERS=none
# 超级管理员密码（逗号分隔）
AUTH_SUPERUSER_PASSWORDS=none


# ------------------- UPLOAD_* 上传限制 -------------------
# 每个会话的文件暂存总大小上限（MB）
UPLOAD_MAX_SESSION_MB=20


# ------------------- WEB_* 前端构建产物路径（内部，指向 frontend/dist） -------------------
# 前端 dist 目录
WEB_DIST_DIR=../frontend/dist
# 前端静态资源目录
WEB_ASSETS_DIR=../frontend/dist/assets
# 前端 index.html
WEB_INDEX_FILE=../frontend/dist/index.html