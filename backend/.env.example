# ═══════════════════════════════════════════════════════════════════
# RAG Simple —— 配置模板（复制为同目录 .env 后按需修改）
#
# 用法：复制本文件为 .env，改需要的项即可（不要提交 .env 到 git）。
# 命名规则：<分组>_<名称>，例如 LLM_MODEL / STORAGE_DB_URL / LOG_PATH。
# 加载顺序（后者覆盖前者）：
#     系统环境变量  >  .env（本模板复制出来的覆盖文件）  >  .env.default（默认基线）
# 运行期动态配置：后台写入数据库 settings 表，优先级最高（DB 覆盖 .env）。
#
# 约定：
#   * 默认值已集中在 .env.default；本文件用于按需覆盖，并作为配置参考。
#   * 值为 none 表示“留空/未设置”（把需要提供的值写在其后）。
#   * 注释请放在配置行的“上一行”，不要写行尾（会被当成值的一部分）。
# ═══════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────
# LLM_*  对话模型（OpenAI 兼容接口）
# ─────────────────────────────────────────────
# 对话模型 API Key【必填】
LLM_API_KEY=none
# 对话模型 API 地址（OpenAI 兼容端点）
LLM_BASE_URL=https://api.openai.com/v1
# 对话模型名称（如 deepseek-v4-flash / gpt-4o-mini）
LLM_MODEL=gpt-4o-mini
# 推理力度：low / medium / high；none 表示不指定
LLM_REASONING_EFFORT=none
# LLM 请求超时（秒）
LLM_TIMEOUT=60
# LLM 请求最大重试次数
LLM_MAX_RETRIES=3


# ─────────────────────────────────────────────
# EMBED_*  嵌入模型（向量化）
# ─────────────────────────────────────────────
# 嵌入模型 API Key【必填】（不再复用 LLM_API_KEY）
EMBED_API_KEY=none
# 嵌入模型 API 地址【必填】（不再复用 LLM_BASE_URL）
EMBED_BASE_URL=none
# 嵌入模型名称（如 BAAI/bge-m3 / text-embedding-3-small）
EMBED_MODEL=text-embedding-3-small
# 嵌入向量维度，需与模型一致（bge-m3 为 1024）
EMBED_DIM=1536


# ─────────────────────────────────────────────
# MINERU_*  PDF 解析服务（MinerU）
# ─────────────────────────────────────────────
# MinerU API Key（JWT，上传 PDF 必填）
MINERU_API_KEY=none
# MinerU API 地址
MINERU_BASE_URL=https://mineru.net/api/v4
# MinerU Token 名称
MINERU_TOKEN_NAME=default
# 模型版本：vlm（高精度）/ lite（快速）
MINERU_MODEL_VERSION=vlm
# 解析语言：ch（中文）/ en（英文）
MINERU_LANGUAGE=ch
# 最大并发数（超出排队，避免限流）
MINERU_MAX_CONCURRENCY=3


# ─────────────────────────────────────────────
# STORAGE_*  存储 / 路径
# ─────────────────────────────────────────────
# 数据根目录（相对 backend/；向量库/日志/上传都在其下）
STORAGE_DATA_DIR=data
# FAISS 向量索引目录
STORAGE_VECTOR_DIR=data/vector_store
# 存储后端：sqlite（本地文件库）/ mysql（Docker 服务）
STORAGE_BACKEND=sqlite
# 数据库连接串（sqlite 默认 sqlite:///data/rag.db）
# MySQL 示例：mysql+pymysql://rag:rag_password@127.0.0.1:3306/rag_simple
STORAGE_DB_URL=sqlite:///data/rag.db


# ─────────────────────────────────────────────
# RETRIEVAL_*  知识库检索
# ─────────────────────────────────────────────
# 检索返回的相似结果数上限
RETRIEVAL_TOP_K=10
# 重排前的候选数量
RETRIEVAL_CANDIDATE_K=5
# 文本块最小字符数（低于此值会被过滤）
RETRIEVAL_MIN_CHUNK=5
# 文本块停用词（逗号分隔，命中即过滤；none 表示不设置）
RETRIEVAL_STOP_WORDS=none


# ─────────────────────────────────────────────
# VECTOR_*  向量后端
# ─────────────────────────────────────────────
# 向量后端：faiss（本地）/ milvus（Docker 服务）
VECTOR_BACKEND=faiss
# Milvus 连接地址
VECTOR_MILVUS_URI=http://127.0.0.1:19530
# Milvus 鉴权 token（关闭鉴权时留空）
VECTOR_MILVUS_TOKEN=none
# Milvus 集合名
VECTOR_MILVUS_COLLECTION=rag_chunks


# ─────────────────────────────────────────────
# OBJECT_*  对象存储（上传文档 / 解析产物）
# ─────────────────────────────────────────────
# 文件后端：local（本地磁盘）/ minio（Docker 服务）
OBJECT_BACKEND=local
# MinIO 地址（host:port）
OBJECT_MINIO_ENDPOINT=127.0.0.1:9000
# MinIO Access Key
OBJECT_MINIO_ACCESS_KEY=none
# MinIO Secret Key
OBJECT_MINIO_SECRET_KEY=none
# MinIO 存储桶名
OBJECT_MINIO_BUCKET=rag-files
# MinIO 是否使用 HTTPS（true / false）
OBJECT_MINIO_SECURE=false


# ─────────────────────────────────────────────
# CACHE_* / REDIS_*  缓存 / 任务进度 / 会话状态
# ─────────────────────────────────────────────
# 缓存后端：inprocess（进程内）/ redis（Redis 服务）
CACHE_BACKEND=inprocess
# Redis 连接地址（cache_backend=redis 时使用）
REDIS_URL=redis://127.0.0.1:6379/0


# ─────────────────────────────────────────────
# MQ_*  消息队列（异步任务）
# ─────────────────────────────────────────────
# 队列后端：inprocess（进程内线程池）/ rabbitmq（Docker 服务）
MQ_BACKEND=inprocess
# RabbitMQ 连接地址
MQ_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
# PDF 解析任务队列名
MQ_PARSE_QUEUE=rag.parse


# ─────────────────────────────────────────────
# AGENT_*  Agent 引擎
# ─────────────────────────────────────────────
# 单次问答的工具调用最大迭代次数（达上限可回复“继续”恢复）
AGENT_MAX_TOOL_ITER=15
# 单次 LLM 输出的最大字符数
AGENT_MAX_OUTPUT_CHARS=8192
# 是否启用 Agent 图运行检查点（断点续跑；true/false）
AGENT_CHECKPOINT_ENABLED=false


# ─────────────────────────────────────────────
# CONTEXT_*  上下文治理
# ─────────────────────────────────────────────
# 历史对话最大保留条数
CONTEXT_HISTORY_MAX=500
# 上下文窗口总字符预算（输入 + 输出上限）
CONTEXT_WINDOW_CHARS=32768
# 输入占用上下文窗口的比例（剩余留给输出）
CONTEXT_INPUT_RATIO=0.8
# 历史压缩比例
CONTEXT_COMPRESSION_RATIO=0.3
# 工具结果分页读取的每页字符数
CONTEXT_TOOL_PAGE_CHARS=5000


# ─────────────────────────────────────────────
# SEARCH_*  联网搜索
# ─────────────────────────────────────────────
# 搜索后端：duckduckgo / searxng / bocha / bing
SEARCH_BACKEND=duckduckgo
# SearXNG 服务地址（仅 backend=searxng 时使用）
SEARCH_SEARXNG_URL=none
# 博查搜索 API Key（仅 backend=bocha 时使用）
SEARCH_BOCHA_KEY=none
# Bing 搜索 API Key（仅 backend=bing 时使用）
SEARCH_BING_KEY=none
# 搜索请求超时（秒）
SEARCH_TIMEOUT=15


# ─────────────────────────────────────────────
# LOG_*  日志
# ─────────────────────────────────────────────
# 日志输出目录
LOG_PATH=data/logs
# 应用日志级别：DEBUG / INFO / WARNING / ERROR
LOG_APP_LEVEL=INFO
# HTTP 请求日志级别
LOG_HTTP_LEVEL=INFO
# 控制台日志级别
LOG_CONSOLE_LEVEL=DEBUG
# 单个日志文件最大大小（MB），超出后轮转
LOG_MAX_MB=10
# 轮转后保留的备份文件数
LOG_BACKUP_COUNT=3


# ─────────────────────────────────────────────
# AUTH_*  认证 / 超级用户
# ─────────────────────────────────────────────
# JWT 签名密钥；none 则由程序启动时自动生成并写入 .env（保持重启稳定）
AUTH_JWT_SECRET=none
# 超级管理员用户名（逗号分隔，与密码一一对应）
AUTH_SUPERUSER_USERS=none
# 超级管理员密码（逗号分隔）
AUTH_SUPERUSER_PASSWORDS=none


# ─────────────────────────────────────────────
# UPLOAD_*  上传限制
# ─────────────────────────────────────────────
# 每个用户的最大存储空间（MB）
UPLOAD_MAX_USER_MB=10


# ─────────────────────────────────────────────
# WEB_*  前端构建产物路径（内部，指向 frontend/dist）
# ─────────────────────────────────────────────
# 前端 dist 目录
WEB_DIST_DIR=../frontend/dist
# 前端静态资源目录
WEB_ASSETS_DIR=../frontend/dist/assets
# 前端 index.html
WEB_INDEX_FILE=../frontend/dist/index.html
